---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<div class="mb-8 max-w-2xl">
  {eyebrow && <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-sky-800">{eyebrow}</p>}
  <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">{title}</h2>
  {description && <p class="mt-3 leading-7 text-slate-600">{description}</p>}
</div>
