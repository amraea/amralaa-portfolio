---
interface Props {
  name: string;
  base?: string;
}

const { name, base = '' } = Astro.props;
const links = [
  { href: '#profile', label: 'Profile' },
  { href: '#experience', label: 'Experience' },
  { href: '#projects', label: 'Projects' },
  { href: '#skills', label: 'Skills' },
  { href: '#programs', label: 'Programs' },
];
---

<header class="border-b border-slate-200 bg-white">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4 sm:px-8">
    <a class="font-semibold tracking-tight" href="#top">{name}</a>
    <nav aria-label="Main navigation" class="hidden gap-6 text-sm text-slate-600 md:flex">
      {links.map((link) => <a class="transition hover:text-slate-950" href={`${base}${link.href}`}>{link.label}</a>)}
    </nav>
    <details class="relative md:hidden">
      <summary class="cursor-pointer list-none rounded border border-slate-300 px-3 py-2 text-sm">Menu</summary>
      <nav aria-label="Mobile navigation" class="absolute right-0 z-10 mt-2 grid min-w-48 gap-1 rounded-lg border border-slate-200 bg-white p-2 shadow-lg">
        {links.map((link) => <a class="rounded px-3 py-2 text-sm hover:bg-slate-100" href={`${base}${link.href}`}>{link.label}</a>)}
      </nav>
    </details>
  </div>
</header>
