---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { data } = project;
const profileEntry = await getEntry('profile', 'profile');
if (!profileEntry) throw new Error('Add the profile entry to src/content/profile/profile.json.');
const profile = profileEntry.data;
const categoryLabels = {
  production: 'Production Project',
  analytics: 'Analytics Project',
  initiative: 'Initiative',
  poc: 'PoC',
  hackathon: 'Hackathon PoC',
  experimental: 'Learning / Experimental Project',
} as const;
---

<BaseLayout title={`${data.title} | ${profile.name}`} description={data.shortDescription}>
  <SiteHeader name={profile.name} base="/" />
  <main class="mx-auto max-w-4xl px-5 py-14 sm:px-8 sm:py-20">
    <a class="text-sm font-medium text-sky-800 underline underline-offset-4" href="/#projects">← All projects</a>
    <article class="mt-8">
      <div class="flex flex-wrap gap-2 text-xs">
        <span class="rounded-full bg-slate-100 px-3 py-1 font-medium">{categoryLabels[data.category]}</span>
        {data.status && <span class="rounded-full border border-slate-200 px-3 py-1">{data.status.replace('-', ' ').replace(/^./, (letter) => letter.toUpperCase())}</span>}
        {data.deploymentStatus && <span class="rounded-full border border-slate-200 px-3 py-1">{data.deploymentStatus === 'non-production' ? 'Not a production deployment' : 'Production deployment'}</span>}
      </div>
      <h1 class="mt-5 text-3xl font-semibold tracking-tight sm:text-5xl">{data.title}</h1>
      <p class="mt-5 text-lg leading-8 text-slate-700">{data.shortDescription}</p>
      {data.developmentContext && <p class="mt-4 text-sm text-slate-500">{data.developmentContext}</p>}
      {data.organization && <p class="mt-2 text-sm text-slate-500">Organization: {data.organization}</p>}
      {data.date && <p class="mt-2 text-sm text-slate-500">{data.date}</p>}
      {data.coverImage && <img class="mt-8 max-h-[32rem] w-full rounded-xl border border-slate-200 object-cover" src={data.coverImage} alt={`${data.title} cover`} loading="lazy" />}

      {data.metrics.length > 0 && (
        <dl class="mt-8 grid gap-4 sm:grid-cols-2">
          {data.metrics.map((metric) => (
            <div class="rounded-lg border border-slate-200 bg-white p-4">
              <dt class="text-sm text-slate-600">{metric.label}</dt>
              <dd class="mt-1 text-xl font-semibold">{metric.value}{metric.unit ? ` ${metric.unit}` : ''}</dd>
              {metric.context && <p class="mt-1 text-sm text-slate-500">{metric.context}</p>}
            </div>
          ))}
        </dl>
      )}

      <dl class="mt-10 grid gap-8">
        {data.businessContext && <div><dt class="font-semibold">Business context</dt><dd class="mt-2 leading-7 text-slate-600">{data.businessContext}</dd></div>}
        {data.challenge && <div><dt class="font-semibold">Challenge</dt><dd class="mt-2 leading-7 text-slate-600">{data.challenge}</dd></div>}
        {data.solution && <div><dt class="font-semibold">Solution</dt><dd class="mt-2 leading-7 text-slate-600">{data.solution}</dd></div>}
        {data.myRole && <div><dt class="font-semibold">My role</dt><dd class="mt-2 leading-7 text-slate-600">{data.myRole}</dd></div>}
        {data.teamContext && <div><dt class="font-semibold">Team context</dt><dd class="mt-2 leading-7 text-slate-600">{data.teamContext}</dd></div>}
        {data.impact && <div><dt class="font-semibold">Impact / outcome</dt><dd class="mt-2 leading-7 text-slate-600">{data.impact}</dd></div>}
        {data.technologies.length > 0 && <div><dt class="font-semibold">Technologies</dt><dd class="mt-2 leading-7 text-slate-600">{data.technologies.join(' · ')}</dd></div>}
        {data.lessonsLearned.length > 0 && <div><dt class="font-semibold">Learning</dt><dd class="mt-2"><ul class="list-disc space-y-2 pl-5 text-slate-600">{data.lessonsLearned.map((item) => <li>{item}</li>)}</ul></dd></div>}
      </dl>
      <div class="mt-8 flex flex-wrap gap-4 text-sm">
        {data.linkedinUrl && <a class="text-sky-800 underline underline-offset-4" href={data.linkedinUrl} target="_blank" rel="noreferrer">LinkedIn</a>}
        {data.githubUrl && <a class="text-sky-800 underline underline-offset-4" href={data.githubUrl} target="_blank" rel="noreferrer">GitHub</a>}
        {data.demoUrl && <a class="text-sky-800 underline underline-offset-4" href={data.demoUrl} target="_blank" rel="noreferrer">Demo</a>}
      </div>
      {data.gallery.length > 0 && <ul class="mt-10 grid gap-4 sm:grid-cols-2">{data.gallery.map((image, index) => <li><img class="w-full rounded-lg border border-slate-200" src={image} alt={`${data.title} gallery image ${index + 1}`} loading="lazy" /></li>)}</ul>}
    </article>
  </main>
</BaseLayout>
