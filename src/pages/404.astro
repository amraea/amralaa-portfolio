---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';

const brandName = 'AMR ALAAELDIN AHMED';
---

<BaseLayout title="Page not found | Amr Alaa" description="The page you requested could not be found." canonicalURL={null} noindex>
  <div class="site-shell">
    <SiteHeader name={brandName} />
    <main class="page-width not-found" aria-labelledby="not-found-title">
      <p class="eyebrow">404 · Page not found</p>
      <h1 id="not-found-title">This page isn’t here.</h1>
      <p class="not-found__copy">The address may have changed, or the page may no longer be available.</p>
      <nav aria-label="404 navigation">
        <a class="button button--blue" href="/">Back to homepage</a>
        <a class="not-found__work" href="/#work">View selected work <span aria-hidden="true">↗</span></a>
      </nav>
    </main>
    <footer class="site-footer">
      <div class="page-width"><a href="/">{brandName}</a><span>Finance × SAP × Business Transformation</span><a href="#not-found-title" class="back-to-top">Back to top ↑</a></div>
    </footer>
  </div>
</BaseLayout>

<style>
  .not-found { min-height: 58vh; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; padding-block: 72px; }
  .not-found .eyebrow { color: var(--blue-deep); font-size: 12px; font-weight: 750; letter-spacing: .13em; text-transform: uppercase; }
  .not-found h1 { max-width: 720px; margin: 0; color: var(--ink); font-size: clamp(38px, 6vw, 64px); font-weight: 620; letter-spacing: -.05em; line-height: 1.08; }
  .not-found__copy { max-width: 540px; margin: 18px 0 0; color: var(--ink-soft); font-size: 17px; line-height: 1.65; }
  .not-found nav { display: flex; flex-wrap: wrap; align-items: center; gap: 22px; margin-top: 28px; }
  .not-found__work { color: var(--ink); font-size: 14px; font-weight: 650; text-underline-offset: 4px; }
  @media (max-width: 560px) { .not-found { min-height: 62vh; padding-block: 48px; } .not-found__copy { font-size: 15px; } }
</style>
