---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SiteHeader from '../components/SiteHeader.astro';

const [profileEntry, experiences, projects, skills, programs, education, certifications] = await Promise.all([
  getEntry('profile', 'profile'),
  getCollection('experience'),
  getCollection('projects'),
  getCollection('skills'),
  getCollection('programs'),
  getCollection('education'),
  getCollection('certifications'),
]);

const profile = profileEntry?.data;
if (!profile) throw new Error('Add a profile entry to src/content/profile/profile.json.');
const personStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: 'https://amralaa.site/',
  description: profile.shortBio,
  email: profile.email ?? undefined,
  sameAs: profile.linkedin ? [profile.linkedin] : undefined,
};

const egpc = experiences.find(({ data }) => data.company.includes('EGPC'));
const corcRoles = experiences
  .filter(({ data }) => data.company.includes('CORC'))
  .sort((a, b) => a.data.startDate.localeCompare(b.data.startDate));
const orderedCertifications = certifications.sort((a, b) => (b.data.issueDate ?? '').localeCompare(a.data.issueDate ?? ''));
const orderedEducation = education.sort((a, b) => (a.data.endDate ?? '').localeCompare(b.data.endDate ?? ''));
const programOrder: Record<string, number> = { 'mdep-ce-cohort-7': 0, 'mdep-hackathon-win': 1, depi: 2 };
const orderedPrograms = programs.sort((a, b) => (programOrder[a.id] ?? 99) - (programOrder[b.id] ?? 99));
const orderedProjects = projects.sort((a, b) => a.data.order - b.data.order);
const coreSkills = skills
  .filter(({ data }) => data.exposure === 'professional-experience')
  .sort((a, b) => a.data.category.localeCompare(b.data.category) || a.data.order - b.data.order);
const expandingSkills = skills
  .filter(({ data }) => data.exposure !== 'professional-experience')
  .sort((a, b) => a.data.category.localeCompare(b.data.category) || a.data.order - b.data.order);
const dateLabel = (date: string | null, long = false) => {
  if (!date) return 'Present';
  const [year, month] = date.split('-').map(Number);
  return new Intl.DateTimeFormat('en', { month: long ? 'long' : 'short', year: 'numeric', timeZone: 'UTC' }).format(new Date(Date.UTC(year, month - 1, 1)));
};
const monthYearLabel = (date: string) => {
  const [year, month] = date.split('-').map(Number);
  return new Intl.DateTimeFormat('en', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(Date.UTC(year, month - 1, 1)));
};
const exposureLabel = (exposure: string) => ({
  'professional-experience': 'Professional experience',
  'project-experience': 'Project experience',
  'hands-on-exposure': 'Hands-on exposure',
  positioning: 'Developing focus',
}[exposure] ?? exposure);
const projectLabels = {
  production: 'Production project',
  analytics: 'Analytics Project',
  initiative: 'Business Process Initiative',
  poc: 'PoC',
  hackathon: 'Hackathon PoC',
  experimental: 'Learning / Experimental',
} as const;
const impactMetrics = [
  { value: '14+', label: 'Years in Finance & SAP' },
  { value: '~980', label: 'SAP Support Activities', detail: 'Within a six-month period' },
  { value: '3', label: 'Company Implementations / Go-Lives', detail: 'Participated in' },
  { value: '11', label: 'Companies covered by SAP Support Analytics' },
];
const portrait = '/images/Gemini_Generated_Image_fawrrsfawrrsfawr.png';
---

<BaseLayout title={`${profile.name} | SAP Finance & Business Transformation`} description={profile.shortBio}>
  <script type="application/ld+json" set:html={JSON.stringify(personStructuredData)} />
  <div id="top" class="site-shell">
    <SiteHeader name="AMR ALAAELDIN AHMED" />

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero__inner page-width">
          <div class="hero__copy">
            <p class="eyebrow eyebrow--light">SAP Finance <span aria-hidden="true">×</span> Business Transformation</p>
            <h1 id="hero-title">AMR ALAAELDIN <span>AHMED</span></h1>
            <p class="hero__lead">Turning finance experience into better SAP processes, analytics, automation and applied AI.</p>
            <p class="hero__expertise">SAP FI/CO <span>·</span> S/4HANA Finance <span>·</span> Process Improvement <span>·</span> Power BI <span>·</span> BTP <span>·</span> Applied AI</p>
            <div class="hero__actions">
              <a class="button button--blue" href="#work">Explore my work <span aria-hidden="true">↘</span></a>
              {profile.resume && <a class="button button--outline-light" href={profile.resume} download>Download CV <span aria-hidden="true">↓</span></a>}
            </div>
          </div>

          <figure class="hero-portrait">
            <div class="hero-portrait__frame">
              <img src={portrait} width="1024" height="1024" alt="Illustrated portrait representing Amr Alaa" fetchpriority="high" />
            </div>
          </figure>

          <div class="hero-path" aria-label="Professional progression">
            <span>Finance</span><b aria-hidden="true">→</b>
            <span>SAP Finance &amp; Process</span><b aria-hidden="true">→</b>
            <span>Data &amp; Automation</span><b aria-hidden="true">→</b>
            <span>BTP &amp; Applied AI</span>
          </div>
        </div>
      </section>

      <section class="evidence" aria-label="Verified experience and project scope">
        <div class="evidence__grid page-width">
          {impactMetrics.map((metric, index) => (
            <div class:list={["evidence__item", { 'evidence__item--first': index === 0 }]}>
              <p class="evidence__value">{metric.value}</p>
              <p class="evidence__label">{metric.label}</p>
              {metric.detail && <p class="evidence__detail">{metric.detail}</p>}
            </div>
          ))}
        </div>
      </section>

      <section id="about" class="section section--paper">
        <div class="page-width">
          <SectionHeading eyebrow="A finance-led foundation" title="From financial operations to business transformation" description="The through-line is a deep understanding of finance, extended through SAP, implementation, analytics and emerging technology." />
          <div class="story-grid">
            <p class="story-copy">Amr’s career began in finance and budgeting at Cairo Oil Refining Company, then moved into SAP support at EGPC. SAP FI/CO, Treasury and Real Estate Management remain the core. Implementation, go-live, requirements clarification, SIT, UAT and business validation connect that finance foundation to business process work.</p>
            <p class="story-copy story-copy--secondary">Power BI project work extends the story into analytics and process improvement. Through MDEP-CE, Amr gained hands-on exposure to SAP CAP, HANA Cloud, APIs, Joule Studio and AI agents. These are developing capabilities that build on his finance and SAP experience.</p>
          </div>
          <ol class="progression" aria-label="Career and capability progression">
            <li><span class="progression__step">01</span><span>Finance</span></li>
            <li><span class="progression__step">02</span><span>SAP Finance</span></li>
            <li><span class="progression__step">03</span><span>Business Process</span></li>
            <li><span class="progression__step">04</span><span>Data &amp; Automation</span></li>
            <li><span class="progression__step">05</span><span>BTP &amp; Applied AI</span></li>
          </ol>
        </div>
      </section>

      <section id="expertise" class="section section--white">
        <div class="page-width">
          <SectionHeading eyebrow="Expertise" title="A strong core. A growing edge." description="Experience is grounded in finance and SAP business processes, with analytics and emerging technologies extending that foundation." />
          <div class="expertise-grid">
            <section class="expertise-panel expertise-panel--core" aria-labelledby="core-title">
              <div class="expertise-panel__heading">
                <span class="section-index">01 / CORE</span>
                <h3 id="core-title">Core experience</h3>
                <p>Capabilities grounded in professional roles.</p>
              </div>
              <ul class="expertise-list">
                {coreSkills.map(({ data }) => (
                  <li><span>{data.name}</span><small>{data.category}</small></li>
                ))}
              </ul>
            </section>
            <section class="expertise-panel expertise-panel--expanding" aria-labelledby="expanding-title">
              <div class="expertise-panel__heading">
                <span class="section-index">02 / EXPANDING</span>
                <h3 id="expanding-title">Expanding the core</h3>
                <p>Project work, hands-on exploration and developing focus.</p>
              </div>
              <ul class="expertise-list">
                {expandingSkills.map(({ data }) => (
                  <li><span>{data.name}</span><small>{exposureLabel(data.exposure)}</small></li>
                ))}
              </ul>
            </section>
          </div>
        </div>
      </section>

      <section id="work" class="section section--paper">
        <div class="page-width">
          <SectionHeading eyebrow="Selected work" title="Applied experience, made visible" description="Projects spanning collaborative AI exploration, support analytics and business process improvement." />
          <div class="work-list">
            {orderedProjects.map((project) => (
              <ProjectCard project={project} categoryLabel={projectLabels[project.data.category]} />
            ))}
          </div>
        </div>
      </section>

      <section id="experience" class="section section--white">
        <div class="page-width">
          <SectionHeading eyebrow="Experience" title="A career in progression" description="One continuous journey from finance and budgeting into SAP Finance support and implementation." />
          <div class="career-layout">
            {egpc && (
              <article class="career-current">
                <div class="career-current__top">
                  <span class="section-index">CURRENT ROLE</span>
                  <p>{dateLabel(egpc.data.startDate, true)} – Present</p>
                </div>
                <p class="career-current__company">Egyptian General Petroleum Corporation</p>
                <h3>{egpc.data.role}</h3>
                <p class="career-current__summary">{egpc.data.summary}</p>
                <ul class="fact-list">
                  {egpc.data.responsibilities.map((item) => <li>{item}</li>)}
                </ul>
              </article>
            )}

            <section class="career-journey" aria-labelledby="corc-title">
              <div class="career-journey__heading">
                <span class="section-index">FINANCE FOUNDATION</span>
                <p>October 2010 – May 2024</p>
              </div>
              <h3 id="corc-title">Cairo Oil Refining Company <span>CORC</span></h3>
              <ol class="role-timeline">
                {corcRoles.map(({ data }) => (
                  <li>
                    <span class="role-timeline__marker" aria-hidden="true"></span>
                    <div><h4>{data.role}</h4><p>{dateLabel(data.startDate, true)} – {dateLabel(data.endDate, true)}</p></div>
                  </li>
                ))}
              </ol>
            </section>
          </div>
        </div>
      </section>

      <section id="credentials" class="section section--paper">
        <div class="page-width">
          <SectionHeading eyebrow="Credentials and programs" title="Learning in practice" description="Programs and team recognition are shown separately from formal education and certifications." />
          <div class="credentials-grid">
            <section class="credentials-panel credentials-panel--formal" aria-label="Formal certifications and education">
              {orderedCertifications.length > 0 && <section aria-labelledby="certifications-title"><span class="section-index">FORMAL CERTIFICATIONS</span><h3 id="certifications-title">Certifications</h3><ul class="credential-list">{orderedCertifications.map(({ data }) => <li><strong>{data.name}</strong><span>{data.issuer}</span>{data.issueDate && <time class="credential-list__date" datetime={data.issueDate}>{`Passed ${monthYearLabel(data.issueDate)}`}</time>}</li>)}</ul></section>}
              {orderedEducation.length > 0 && <section class="education-list" aria-labelledby="education-title"><span class="section-index">EDUCATION</span><h3 id="education-title">Education</h3><ol>{orderedEducation.map(({ data }) => <li><div><strong>{data.qualification}</strong>{data.fieldOfStudy && <span>{data.fieldOfStudy}</span>}</div><p>{data.institution}{data.endDate && <> · <time datetime={data.endDate}>{data.endDate}</time></>}</p></li>)}</ol></section>}
              </section>
            <section class="credentials-panel credentials-panel--programs" aria-labelledby="programs-title">
              <span class="section-index">PROGRAMS &amp; ACHIEVEMENTS</span>
              <h3 id="programs-title">Selected programs and recognition</h3>
              <ul class="program-list">
                {orderedPrograms.map(({ data }) => (
                  <li><span class="program-list__type">{data.type === 'award' ? 'Team achievement' : 'Program'}</span><div><h4>{data.title}</h4>{((data.organization && data.organization !== data.title) || data.location || data.date) && <p class="program-list__meta">{[data.organization !== data.title ? data.organization : null, data.location, data.date].filter(Boolean).join(' · ')}</p>}<p class="program-list__summary">{data.summary}</p></div></li>
                ))}
              </ul>
            </section>
          </div>
        </div>
      </section>

      <section id="contact" class="contact-section">
        <div class="contact-section__inner page-width">
          <div>
            <p class="eyebrow eyebrow--light">Next step</p>
            <h2>See the experience<br />behind the work.</h2>
            <p>For conversations about SAP Finance, implementation and transformation, process improvement, analytics and automation, or BTP and applied-AI exploration.</p>
          </div>
          <div class="contact-section__actions">
            {profile.email && <a class="button button--blue" href={`mailto:${profile.email}`}>Email Amr</a>}
            {profile.linkedin && <a class="button button--outline-light" href={profile.linkedin}>Connect on LinkedIn <span aria-hidden="true">↗</span></a>}
            {profile.resume && <a class="button button--outline-light" href={profile.resume} download>Download CV <span aria-hidden="true">↓</span></a>}
            {profile.phone && <a class="contact-phone" href={`tel:${profile.phone.replace(/[^\d+]/g, '')}`}>Phone: {profile.phone}</a>}
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="page-width"><a href="#top">AMR ALAAELDIN AHMED</a><span>Finance × SAP × Business Transformation</span><a href="#top" class="back-to-top">Back to top ↑</a></div>
    </footer>
  </div>
</BaseLayout>
