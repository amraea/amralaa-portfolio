---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SiteHeader from '../components/SiteHeader.astro';

const [profileEntry, experiences, projects, skills, programs, education, certifications] = await Promise.all([
  getEntry('profile', 'profile'),
  getCollection('experience'),
  getCollection('projects'),
  getCollection('skills'),
  getCollection('programs'),
  getCollection('education'),
  getCollection('certifications'),
]);

const profile = profileEntry?.data;
if (!profile) throw new Error('Add a profile entry to src/content/profile/profile.json.');

const orderedExperience = experiences.sort((a, b) => b.data.startDate.localeCompare(a.data.startDate));
const orderedProjects = projects.sort((a, b) => a.data.order - b.data.order);
const skillCategories = [...new Set(skills.map((skill) => skill.data.category))];
const dateLabel = (date: string | null) => {
  if (!date) return 'Present';
  const [year, month] = date.split('-').map(Number);
  return new Intl.DateTimeFormat('en', { month: 'short', year: 'numeric', timeZone: 'UTC' }).format(new Date(Date.UTC(year, month - 1, 1)));
};
---

<BaseLayout title={`${profile.name} | SAP Finance & Business Process`} description={profile.shortBio}>
  <div id="top">
    <SiteHeader name={profile.name} />
    <main class="mx-auto max-w-6xl px-5 sm:px-8">
      <section id="profile" class="scroll-mt-8 border-b border-slate-200 py-16 sm:py-24">
        <p class="text-sm font-semibold uppercase tracking-wide text-sky-800">Portfolio</p>
        <h1 class="mt-4 max-w-4xl text-4xl font-semibold tracking-tight sm:text-6xl">{profile.name}</h1>
        <p class="mt-5 max-w-3xl text-xl leading-8 text-slate-700">{profile.professionalHeadline}</p>
        <p class="mt-5 max-w-3xl leading-7 text-slate-600">{profile.shortBio}</p>
        <div class="mt-7 flex flex-wrap gap-4">
          {profile.resume && <a class="rounded-md bg-slate-900 px-5 py-3 font-medium text-white hover:bg-slate-700" href={profile.resume} download>Download resume</a>}
          {profile.email && <a class="rounded-md border border-slate-300 px-5 py-3 font-medium hover:bg-white" href={`mailto:${profile.email}`}>Email</a>}
          {profile.linkedin && <a class="rounded-md border border-slate-300 px-5 py-3 font-medium hover:bg-white" href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>}
          {profile.github && <a class="rounded-md border border-slate-300 px-5 py-3 font-medium hover:bg-white" href={profile.github} target="_blank" rel="noreferrer">GitHub</a>}
        </div>
        {profile.impactMetrics.length > 0 && (
          <dl class="mt-12 grid gap-4 sm:grid-cols-2">
            {profile.impactMetrics.map((metric) => (
              <div class="rounded-lg border border-slate-200 bg-white p-5">
                <dt class="text-sm text-slate-600">{metric.label}</dt>
                <dd class="mt-1 text-2xl font-semibold">{metric.value}</dd>
                {metric.context && <p class="mt-1 text-sm text-slate-500">{metric.context}</p>}
              </div>
            ))}
          </dl>
        )}
      </section>

      {orderedExperience.length > 0 && (
        <section id="experience" class="scroll-mt-8 border-b border-slate-200 py-14 sm:py-20">
          <SectionHeading eyebrow="Career" title="Experience" description="Finance and SAP roles across EGPC and Cairo Oil Refining Company." />
          <div class="grid gap-4">
            {orderedExperience.map(({ data }) => (
              <article class="rounded-xl border border-slate-200 bg-white p-5 sm:p-6">
                <div class="flex flex-col justify-between gap-2 sm:flex-row sm:gap-6">
                  <div>
                    <h3 class="font-semibold">{data.role}</h3>
                    <p class="mt-1 text-slate-600">{data.company}</p>
                  </div>
                  <p class="shrink-0 text-sm text-slate-500">{dateLabel(data.startDate)} – {dateLabel(data.endDate)}</p>
                </div>
                {data.summary && <p class="mt-4 leading-7 text-slate-600">{data.summary}</p>}
                {data.responsibilities.length > 0 && <ul class="mt-4 list-disc space-y-2 pl-5 text-slate-600">{data.responsibilities.map((item) => <li>{item}</li>)}</ul>}
                {data.achievements.length > 0 && <ul class="mt-4 list-disc space-y-2 pl-5 text-slate-600">{data.achievements.map((item) => <li>{item}</li>)}</ul>}
              </article>
            ))}
          </div>
        </section>
      )}

      {orderedProjects.length > 0 && (
        <section id="projects" class="scroll-mt-8 border-b border-slate-200 py-14 sm:py-20">
          <SectionHeading eyebrow="Selected work" title="Projects" description="Project category, delivery status, and development context are shown separately." />
          <div class="grid gap-4 md:grid-cols-2">
            {orderedProjects.map((project) => <ProjectCard project={project} />)}
          </div>
        </section>
      )}

      {skillCategories.length > 0 && (
        <section id="skills" class="scroll-mt-8 border-b border-slate-200 py-14 sm:py-20">
          <SectionHeading eyebrow="Capabilities" title="Skills & exposure" description="Experience labels show whether a skill comes from a role, a project, or hands-on exploration." />
          <div class="grid gap-4 sm:grid-cols-2">
            {skillCategories.map((category) => (
              <section class="rounded-xl border border-slate-200 bg-white p-5" aria-label={category}>
                <h3 class="font-semibold">{category}</h3>
                <ul class="mt-4 space-y-3">
                  {skills.filter((skill) => skill.data.category === category).sort((a, b) => a.data.order - b.data.order).map(({ data }) => (
                    <li class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
                      <span>{data.name}</span>
                      <span class="text-xs text-slate-500">{data.exposure.replaceAll('-', ' ')}</span>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        </section>
      )}

      {programs.length > 0 && (
        <section id="programs" class="scroll-mt-8 border-b border-slate-200 py-14 sm:py-20">
          <SectionHeading eyebrow="Programs & recognition" title="Programs and achievements" description="Programs and team recognition connected to the project work." />
          <ul class="grid gap-4 sm:grid-cols-2">
            {programs.map(({ data }) => (
              <li class="rounded-xl border border-slate-200 bg-white p-5">
                <p class="text-xs font-semibold uppercase tracking-wide text-sky-800">{data.type}</p>
                <h3 class="mt-2 font-semibold">{data.title}</h3>
                {data.organization && <p class="mt-1 text-sm text-slate-600">{data.organization}</p>}
                <p class="mt-3 leading-7 text-slate-600">{data.summary}</p>
              </li>
            ))}
          </ul>
        </section>
      )}

      {(education.length > 0 || certifications.length > 0) && (
        <section class="py-14 sm:py-20" aria-label="Education and certifications">
          {education.length > 0 && <div><SectionHeading title="Education" /><ul class="space-y-4">{education.map(({ data }) => <li><strong>{data.qualification}</strong>{data.fieldOfStudy && ` — ${data.fieldOfStudy}`} · {data.institution}</li>)}</ul></div>}
          {certifications.length > 0 && <div class="mt-12"><SectionHeading title="Certifications" /><ul class="space-y-4">{certifications.map(({ data }) => <li><strong>{data.name}</strong> · {data.issuer}</li>)}</ul></div>}
        </section>
      )}
    </main>
    <footer class="border-t border-slate-200 bg-white px-5 py-6 text-center text-sm text-slate-500">
      <p>{profile.name}</p>
    </footer>
  </div>
</BaseLayout>
